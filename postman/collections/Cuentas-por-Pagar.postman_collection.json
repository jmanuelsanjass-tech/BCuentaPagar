            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Demo\",\n  \"documento\": \"12345678\",\n  \"email\": \"cliente@demo.com\",\n  \"telefono\": \"555-1234\",\n  \"direccion\": \"Calle Falsa 123\"\n}"
            }
          }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PUT",
