            "url": { "raw": "{{baseUrl}}/api/clientes/{{id}}", "host": ["{{baseUrl}}"], "path": ["api","clientes","{{id}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Demo Actualizado\",\n  \"documento\": \"12345678\",\n  \"email\": \"nuevo@demo.com\",\n  \"telefono\": \"555-9999\",\n  \"direccion\": \"Otra dirección 456\"\n}"
            }
          }
        },
        {
          "name": "Eliminar",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/clientes/{{id}}", "host": ["{{baseUrl}}"], "path": ["api","clientes","{{id}}"] }
          }
        }
      ]
