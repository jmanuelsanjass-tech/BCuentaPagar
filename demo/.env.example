# Agrega estos valores a tu archivo local .env (no uses este archivo como almacén de secretos).
# DB_PASSWORD es requerido por Docker Compose para la base de datos PostgreSQL.
DB_PASSWORD=replace-with-a-strong-db-password

# Crea el usuario inicial si no existe y sincroniza su contraseña con este valor al iniciar.
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=replace-with-a-unique-strong-password
