# Environment Configuration
# Copy this file to .env and update with your actual values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cuentas_pagar
DB_USER=
DB_PASSWORD=

# Server
PORT=8080
SERVER_URL=http://localhost:8080

# API Configuration
API_VERSION=v1

# Logging
LOG_LEVEL=INFO

# Security
SECRET_KEY=
JWT_SECRET=

# Email Configuration
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=

# Third-party Services
# Add any API keys or external service configurations here

# Application
ENVIRONMENT=development
